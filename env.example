# Copier vers .env.local et renseigner les valeurs.

# Supabase (obligatoire pour Auth et l'app)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Site public FasoBar
NEXT_PUBLIC_SITE_URL=https://fasobar.com

# Installateur Windows publié (URL HTTPS publique, jamais un chemin local)
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=
NEXT_PUBLIC_DESKTOP_APP_VERSION=0.1.0

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production / electron-builder assets (track icons only)
/build/*
!/build/icon.ico
!/build/installerIcon.ico
!/build/uninstallerIcon.ico
!/build/icon-source.png
!/build/installer.nsh

# electron-builder output
/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# desktop / electron
/desktop/resources/
/out/
/.vite/
/.fasobar-local-data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# electron / build temporary logs
forge-package.log
squirrel-make.log
out-make-log.txt
prepare-*.txt
